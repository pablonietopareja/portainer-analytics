# Optional Docker Compose settings. Do not put Portainer tokens in this file.
# Loopback by default. Set 0.0.0.0 only for intentional LAN access after secure setup.
CONSOLE_BIND_ADDRESS=127.0.0.1
# Empty: shared links use the address opened by the browser.
# HTTPS behind a reverse proxy: CONSOLE_PUBLIC_URL=https://analytics.example.com
CONSOLE_PUBLIC_URL=
# Comma-separated DNS names. Localhost and private LAN IPs work without this.
CONSOLE_ALLOWED_HOSTS=
